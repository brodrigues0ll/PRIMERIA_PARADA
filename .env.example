# Gerado com: openssl rand -base64 32
NEXTAUTH_SECRET=seu_secret_aqui

# URL do frontend
NEXTAUTH_URL=http://localhost:3000

# String de conexão MongoDB
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/primeira-parada

# URL da API do backend (usada pelo frontend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# MinIO — Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=produtos
# URL pública do MinIO acessível pelo browser
MINIO_PUBLIC_URL=http://localhost:9000
