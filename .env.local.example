# ── Geral ─────────────────────────────────────────────────────────────────────
TZ=America/Sao_Paulo
NODE_ENV=development

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=seu_secret_aqui
NEXTAUTH_URL=http://localhost:3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/primeira-parada

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=produtos
MINIO_PUBLIC_URL=http://localhost:9000

# ── WhatsApp (OpenWA) ─────────────────────────────────────────────────────────
# URL interna (frontend → container) e pública (browser → host)
WA_INTERNAL_URL=http://whatsapp:2785
NEXT_PUBLIC_WA_URL=http://localhost:3099

# Chave de API — deve ser igual a API_MASTER_KEY abaixo
WA_API_KEY=troque-por-uma-chave-segura

# OpenWA
API_MASTER_KEY=troque-por-uma-chave-segura
ALLOW_DEV_API_KEY=true
ENABLE_SWAGGER=false
LOG_LEVEL=info

# Engine: baileys (leve, sem Chrome) ou wwebjs (Chrome, mais compatível)
ENGINE_TYPE=baileys

# Sessões
AUTO_START_SESSIONS=true
SESSION_DATA_PATH=/app/data/sessions

# Banco de dados (SQLite para dev)
DATABASE_TYPE=sqlite
DATABASE_SYNCHRONIZE=true

# Storage de mídia
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/data/media
PLUGINS_DIR=/app/data/plugins

# Baileys
BAILEYS_SYNC_FULL_HISTORY=true
RESOLVE_LID_TO_PHONE=true

# Limites
BODY_SIZE_LIMIT=50mb
